<?xml version="1.0" encoding="UTF-8"?>
<!--
  JoomCCK GHSA-whf2-8p4w-v6xv defense-in-depth (IIS).
  These template/config files are always include()d by PHP, never requested
  directly, so denying direct access breaks nothing and blocks the
  "write .php here then GET it" step of an arbitrary-file-write attack.
-->
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>
                <fileExtensions>
                    <add fileExtension=".php" allowed="false" />
                    <add fileExtension=".php3" allowed="false" />
                    <add fileExtension=".php4" allowed="false" />
                    <add fileExtension=".php5" allowed="false" />
                    <add fileExtension=".php7" allowed="false" />
                    <add fileExtension=".phtml" allowed="false" />
                    <add fileExtension=".phps" allowed="false" />
                    <add fileExtension=".pht" allowed="false" />
                    <add fileExtension=".phar" allowed="false" />
                    <add fileExtension=".inc" allowed="false" />
                    <add fileExtension=".json" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
